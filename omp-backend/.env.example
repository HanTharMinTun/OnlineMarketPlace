# Server
PORT=5000

# PostgreSQL connection (used by src/config/db.js)
# Either provide DATABASE_URL ...
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/online_market_place
# ... or the individual variables:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace_with_your_postgres_password
PGDATABASE=online_market_place
# Set to "true" when your provider requires TLS
PGSSL=false

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# --- Token transport ---------------------------------------------------------
# false (default) -> login returns the JWT in the JSON body and clients send
#                    "Authorization: Bearer <token>". The token is kept in
#                    browser storage, where any XSS can read it.
# true            -> login ALSO sets an HttpOnly + SameSite cookie, which
#                    JavaScript cannot read. The Bearer header keeps working, so
#                    enabling this does not break existing clients.
#                    Requires CORS credentials (already enabled in src/app.js).
AUTH_COOKIE_MODE=false
# SameSite policy for the auth cookie: lax (default) | strict | none
# Use "none" only if the UI and API are on genuinely different sites (needs HTTPS).
COOKIE_SAME_SITE=lax
# Header/value required on cookie-authenticated writes (CSRF defence).
# The bundled frontend already sends these; the defaults are fine.
AUTH_CSRF_HEADER=x-requested-with
AUTH_CSRF_VALUE=XMLHttpRequest

# --- Password recovery -------------------------------------------------------
# Base URL of the frontend reset page. The token is appended as ?token=...
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# How long a reset link stays valid, in minutes.
PASSWORD_RESET_TTL_MINUTES=30
# Abuse limits (per 15 minutes). The email limit applies per address.
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_IP_LIMIT=10
PASSWORD_RESET_ATTEMPT_LIMIT=20
# Development ONLY: include the reset link in the API response so the flow can
# be completed without a mailbox. Refused automatically when NODE_ENV=production.
AUTH_EXPOSE_RESET_TOKEN=false

# --- Outgoing email (required for password recovery) -------------------------
# Leave SMTP_HOST empty and the mailer writes messages to the server log instead
# of sending them; /forgot-password then answers 503 in production and reports
# emailSent:false in development - it never claims an email was delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Online Marketplace <no-reply@example.com>
APP_NAME=Online Marketplace

# CORS (comma separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173
