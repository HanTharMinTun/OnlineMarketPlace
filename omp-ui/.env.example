# API base URL used by src/auth_and_user/services/authService.js
# The Express backend mounts the auth router at /api/auth and listens on PORT
# (default 5000 - see omp-backend/src/server.js and omp-backend/.env).
VITE_API_BASE_URL=http://localhost:5000/api

# The frontend supports BOTH token transports and needs no configuration for
# either one - it always sends `credentials: 'include'` and attaches the Bearer
# token when one is stored. Switch the backend's AUTH_COOKIE_MODE instead:
#   AUTH_COOKIE_MODE=true  -> the session lives in an HttpOnly cookie
#   AUTH_COOKIE_MODE=false -> the session is a Bearer token in web storage
